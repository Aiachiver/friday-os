# ============================================================
# FRIDAY OS — Environment Variables
#
# WINDOWS NOTE: Do NOT create your real .env by right-click ->
# New -> Text Document, then renaming — Notepad/Explorer will
# silently save it as ".env.txt". And if you extract this repo
# from a zip made by Windows' built-in "Compress" tool, files
# that start with "." are sometimes skipped.
#
# Safest way to create .env on Windows (PowerShell, from the
# project root):
#
#   Copy-Item .env.example .env
#
# Or from scratch:
#
#   New-Item -Path .env -ItemType File
#
# Then edit it with VS Code / any editor that lets you save an
# exact filename. Verify it worked with:
#
#   Get-ChildItem -Force | Select-String -Pattern "\.env$"
#
# (the -Force flag matters — dotfiles are hidden by default in
# Explorer and easy to mis-verify otherwise)
# ============================================================

# --- Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- AI Providers (Phase 3) — leave blank for now, fill in as you enable each provider ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Voice / Wake Word (Phase 2) ---
# Free key from https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=
# Path to your trained "Friday" Windows keyword file (.ppn). See
# docs/architecture/WAKE_WORD_SETUP.md for how to generate this.
FRIDAY_KEYWORD_PATH=resources/wake_word/friday_windows.ppn

# --- TTS (Phase 2) ---
ELEVENLABS_API_KEY=

# --- Finance (Phase 4) ---
# No API key needed -- market data comes from yfinance (free, keyless).

# --- Vision / OCR (Phase 5) ---
# Only needed if Tesseract isn't on your PATH. See
# docs/architecture/VISION_SETUP.md for install steps.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Spotify plugin (Phase 6) ---
# Free to create at https://developer.spotify.com/dashboard.
# See docs/architecture/SPOTIFY_SETUP.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Coding assistant: GitHub repo creation (optional) ---
# Fine-grained personal access token with "Repository creation" permission,
# from https://github.com/settings/tokens. Only needed for the
# create_github_repo tool; git_status/git_commit/etc. work with local git
# alone and need no token at all.
GITHUB_TOKEN=

# --- Database ---
DATABASE_URL=sqlite:///data/db/friday.db

# --- Security ---
# Random 32+ char secret used to encrypt locally-stored secrets/tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
